## This is an example .gitignore file.
## To easily generate a .gitignore file, use: https://www.toptal.com/developers/gitignore
## Or cURL a gitignore file from the command line: curl -o .gitignore https://www.toptal.com/developers/gitignore/api/NAME_OF_DESIRED_GITIGNORE_FILE

# # Node.js dependencies
# node_modules/

# # Python
# __pycache__/
# *.pyc
# *.pyo
# *.pyd
# .Python
# venv/
# pip-log.txt
# .tox/

# # Logs and databases
# *.log
# *.sql
# *.sqlite

# # OS generated files
# .DS_Store
# .DS_Store?
# ._*
# .Spotlight-V100
# .Trashes
# ehthumbs.db
# Thumbs.db

# # IDEs and editors
# .vscode/
# .idea/
# *.swp
# *.swo
# *.sublime
# *.sublime-workspace

# # Build artifacts
# /dist/
# /tmp/
# /out/
# /build/
# *.dmg
# *.exe
# *.zip
# *.tar.gz

# # Environment variables and configurations
# .env
# .env.local
# .env.development.local
# .env.test.local
# .env.production.local

# # Ignore all markdown files except README.md
# *.md
# !README.md
