#!/usr/bin/env bash

# PHI Scanner - Git pre-commit hook.
# Fetches the latest mlops-phi-hooks release on every commit and runs it to
# scan staged content. The scanner is pure standard-library Python with no
# dependencies, so no venv or pip is needed (Databricks hook environments
# often cannot create one).

set -uo pipefail

PHI_REPO_URL="${PHI_REPO_URL:-https://github.com/Intermountain-Health/data-mlops-github-hooks.git}"

export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/mlops-phi.XXXXXX")" || {
    echo "ERROR: cannot create a temporary directory."; echo "Commit blocked."; exit 1;
}
trap 'rm -rf "$WORK"' EXIT

block() {
    echo "ERROR: $1"
    echo "Commit blocked."
    exit 1
}

# Returns "<branch>@<sha>" for the highest release/v* branch, e.g. release/v1.2@635ebd5...
latest_tag() {
    git ls-remote --heads --refs --sort=-v:refname "$PHI_REPO_URL" 'refs/heads/release/v*' 2>/dev/null \
        | awk 'NR==1 { sub("refs/heads/", "", $2); print $2 "@" $1 }'
}

# First Python >= 3.9 found. Override with PHI_PYTHON.
find_python() {
    local p
    for p in ${PHI_PYTHON:-} python3 python /databricks/python3/bin/python3 /usr/bin/python3; do
        command -v "$p" >/dev/null 2>&1 || continue
        if "$p" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
            command -v "$p"
            return 0
        fi
    done
    return 1
}

# Shallow-clones the release branch and lays out src/ as the mlops_phi package.
fetch_scanner() {
    local branch="${1%@*}" log="$WORK/fetch.log"
    # Git exports GIT_INDEX_FILE (and possibly GIT_DIR/GIT_WORK_TREE) to hooks;
    # a nested clone would inherit them and overwrite this commit's index.
    if ! (
        unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR \
              GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
        git clone -q --depth 1 --branch "$branch" "$PHI_REPO_URL" "$WORK/repo"
    ) >"$log" 2>&1; then
        grep -v -i 'credential' "$log" | tail -n 20
        return 1
    fi
    [ -f "$WORK/repo/src/pre_commit.py" ] || { echo "src/pre_commit.py not found in $branch"; return 1; }
    mkdir -p "$WORK/pkg" && cp -R "$WORK/repo/src" "$WORK/pkg/mlops_phi"
}

tag="$(latest_tag)"
[ -n "$tag" ] || block "no release/v* branch found at $PHI_REPO_URL"

PY="$(find_python)" || block "no Python >= 3.9 found (set PHI_PYTHON)."

echo "PHI pre-commit: fetching scanner $tag..."
fetch_scanner "$tag" || block "could not fetch scanner $tag"

# -I: isolated mode, so repo folders in the cwd cannot shadow stdlib modules.
"$PY" -I -c '
import sys
sys.path.insert(0, sys.argv[1])
from mlops_phi.pre_commit import main
sys.exit(main(sys.argv[2:]))
' "$WORK/pkg" --staged
rc=$?

if [ "$rc" -ne 0 ]; then
    echo "Emergency bypass: git commit --no-verify"
fi
exit "$rc"